# Ingress Traefik (intégré à K3s) + TLS émis par cert-manager (auto-signé).
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: odoo
  namespace: {{ odoo_namespace }}
  annotations:
    cert-manager.io/cluster-issuer: selfsigned-issuer
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
spec:
  ingressClassName: traefik
  tls:
    - hosts:
        - {{ odoo_host }}
      secretName: odoo-tls
  rules:
    - host: {{ odoo_host }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: odoo
                port:
                  number: 8069
          - path: /websocket
            pathType: Prefix
            backend:
              service:
                name: odoo
                port:
                  number: 8072
